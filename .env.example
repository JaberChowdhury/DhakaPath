# DhakaPath Environment Configuration Template
# Copy to .env.local for local development. NEVER commit real credentials.

# Supabase Public & Client Configuration (Browser Accessible)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy_anon_key_for_client_requests

# Privileged Supabase Backend Service Role (SERVER-SIDE ONLY - NEVER EXPOSE TO BROWSER)
SUPABASE_SERVICE_ROLE_KEY=dummy_service_role_secret_key_server_only

# Free-Tier AI Provider Configuration (SERVER-SIDE ONLY - NEVER EXPOSE TO BROWSER)
# Supported Providers: gemini | groq | openai | mock
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash
LLM_API_KEY=your_free_tier_gemini_api_key

# Optional App Defaults
NEXT_PUBLIC_APP_URL=http://localhost:3000
